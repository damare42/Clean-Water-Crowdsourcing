<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SecurityLogController">
   <children>
      <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <VBox alignment="CENTER" spacing="4.0" BorderPane.alignment="CENTER">
               <children>
                  <Label text="Security Log (newest first)" />
                  <Label fx:id="message" managed="false" textFill="#d32020" visible="false" wrapText="true" />
               </children>
               <padding>
                  <Insets bottom="6.0" top="10.0" />
               </padding>
            </VBox>
         </top>
         <center>
            <TableView fx:id="eventTable" BorderPane.alignment="CENTER">
               <placeholder>
                  <Label text="No events yet" />
               </placeholder>
               <columns>
                  <TableColumn fx:id="sequenceColumn" prefWidth="50.0" text="#" />
                  <TableColumn fx:id="timeColumn" prefWidth="140.0" text="Time" />
                  <TableColumn fx:id="typeColumn" prefWidth="130.0" text="Event" />
                  <TableColumn fx:id="actorColumn" prefWidth="100.0" text="By" />
                  <TableColumn fx:id="subjectColumn" prefWidth="110.0" text="Account" />
                  <TableColumn fx:id="detailColumn" prefWidth="230.0" text="Detail" />
               </columns>
            </TableView>
         </center>
         <bottom>
            <HBox alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
               <children>
                  <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#refreshPressed" text="Refresh" />
                  <Button fx:id="goBack" mnemonicParsing="false" onAction="#backPressed" text="Back" />
               </children>
               <padding>
                  <Insets bottom="10.0" top="10.0" />
               </padding>
            </HBox>
         </bottom>
      </BorderPane>
   </children>
</AnchorPane>
