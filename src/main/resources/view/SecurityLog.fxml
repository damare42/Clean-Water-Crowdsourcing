<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SecurityLogController">
   <children>
      <HBox styleClass="page-header">
         <children>
            <VBox minWidth="0.0" spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label styleClass="page-title" text="Security log" />
                        <Label fx:id="countBadge" managed="false" minWidth="-Infinity" styleClass="badge, badge-neutral" visible="false" />
                     </children>
                  </HBox>
                  <Label styleClass="page-subtitle" text="Sign-ins, registrations and account changes, newest first." wrapText="true" />
               </children>
            </VBox>
            <HBox styleClass="page-actions">
               <children>
                  <Button fx:id="refreshButton" minWidth="-Infinity" mnemonicParsing="false" onAction="#refreshPressed" text="Refresh">
                     <graphic><FontIcon iconLiteral="mdomz-refresh" /></graphic>
                     <tooltip><Tooltip text="Load the newest events" /></tooltip>
                  </Button>
               </children>
            </HBox>
         </children>
      </HBox>
      <Label fx:id="message" managed="false" maxWidth="Infinity" styleClass="banner, banner-danger" visible="false" wrapText="true">
         <graphic><FontIcon iconLiteral="mdoal-error_outline" /></graphic>
      </Label>
      <TableView fx:id="eventTable" VBox.vgrow="ALWAYS">
         <placeholder>
            <VBox styleClass="empty-state">
               <children>
                  <FontIcon iconLiteral="mdoal-inbox" styleClass="empty-icon" />
                  <Label styleClass="empty-title" text="No events yet" />
                  <Label styleClass="empty-text" text="Sign-ins and account changes will be listed here." wrapText="true" />
               </children>
            </VBox>
         </placeholder>
         <columns>
                  <TableColumn fx:id="sequenceColumn" minWidth="44" prefWidth="50" styleClass="numeric" text="#" />
                  <TableColumn fx:id="timeColumn" minWidth="160" prefWidth="165" text="Time" />
                  <TableColumn fx:id="typeColumn" minWidth="170" prefWidth="180" text="Event" />
                  <TableColumn fx:id="actorColumn" minWidth="70" prefWidth="80" text="By" />
                  <TableColumn fx:id="subjectColumn" minWidth="80" prefWidth="90" text="Account" />
                  <TableColumn fx:id="detailColumn" minWidth="140" prefWidth="140" text="Detail" />
         </columns>
      </TableView>
   </children>
</VBox>
