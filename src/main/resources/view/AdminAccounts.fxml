<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AdminAccountsController">
   <children>
      <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <VBox alignment="CENTER" spacing="4.0" BorderPane.alignment="CENTER">
               <children>
                  <Label text="Accounts" />
                  <Label fx:id="message" wrapText="true" />
               </children>
               <padding>
                  <Insets bottom="6.0" top="10.0" />
               </padding>
            </VBox>
         </top>
         <center>
            <TableView fx:id="accountTable" BorderPane.alignment="CENTER">
               <placeholder>
                  <Label text="No accounts" />
               </placeholder>
               <columns>
                  <TableColumn fx:id="idColumn" prefWidth="140.0" text="Username" />
                  <TableColumn fx:id="typeColumn" prefWidth="80.0" text="Type" />
                  <TableColumn fx:id="firstNameColumn" prefWidth="110.0" text="First name" />
                  <TableColumn fx:id="lastNameColumn" prefWidth="110.0" text="Last name" />
                  <TableColumn fx:id="emailColumn" prefWidth="190.0" text="Email" />
                  <TableColumn fx:id="statusColumn" prefWidth="80.0" text="Status" />
               </columns>
            </TableView>
         </center>
         <bottom>
            <HBox alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
               <children>
                  <Button fx:id="banButton" mnemonicParsing="false" onAction="#banPressed" text="Ban" />
                  <Button fx:id="unbanButton" mnemonicParsing="false" onAction="#unbanPressed" text="Unban" />
                  <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#deletePressed" text="Delete" />
                  <Button fx:id="goBack" mnemonicParsing="false" onAction="#backPressed" text="Back" />
               </children>
               <padding>
                  <Insets bottom="10.0" top="10.0" />
               </padding>
            </HBox>
         </bottom>
      </BorderPane>
   </children>
</AnchorPane>
