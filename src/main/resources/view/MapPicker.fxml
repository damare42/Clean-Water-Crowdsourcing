<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.web.WebView?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MapPickerController">
   <top>
      <HBox styleClass="picker-header">
         <children>
            <FontIcon iconLiteral="mdomz-touch_app" />
            <Label text="Click the map to choose the location. Drag to move, scroll to zoom." wrapText="true" />
         </children>
      </HBox>
   </top>
   <center>
      <WebView fx:id="mapView" minHeight="0.0" minWidth="0.0" />
   </center>
   <bottom>
      <HBox styleClass="picker-footer">
         <children>
            <Label fx:id="selection" minWidth="0.0" styleClass="selection-chip" text="No location chosen yet">
               <graphic><FontIcon iconLiteral="mdomz-place" /></graphic>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="cancel" cancelButton="true" minWidth="-Infinity" mnemonicParsing="false" onAction="#cancelPressed" text="Cancel" />
            <Button fx:id="useButton" defaultButton="true" minWidth="-Infinity" mnemonicParsing="false" onAction="#usePressed" styleClass="accent" text="Use this location">
               <graphic><FontIcon iconLiteral="mdoal-check" /></graphic>
            </Button>
         </children>
      </HBox>
   </bottom>
</BorderPane>
