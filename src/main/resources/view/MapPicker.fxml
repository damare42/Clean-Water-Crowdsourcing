<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.web.WebView?>

<AnchorPane prefHeight="520.0" prefWidth="720.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MapPickerController">
   <children>
      <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <Label text="Click the map where the water source is." BorderPane.alignment="CENTER_LEFT">
               <padding>
                  <Insets bottom="6.0" left="10.0" top="6.0" />
               </padding>
            </Label>
         </top>
         <center>
            <WebView fx:id="mapView" BorderPane.alignment="CENTER" />
         </center>
         <bottom>
            <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
               <children>
                  <Label fx:id="selection" text="No location chosen yet" />
                  <Pane HBox.hgrow="ALWAYS" />
                  <Button fx:id="useButton" defaultButton="true" mnemonicParsing="false" onAction="#usePressed" text="Use this location" />
                  <Button fx:id="cancel" cancelButton="true" mnemonicParsing="false" onAction="#cancelPressed" text="Cancel" />
               </children>
               <padding>
                  <Insets bottom="8.0" left="10.0" right="10.0" top="8.0" />
               </padding>
            </HBox>
         </bottom>
      </BorderPane>
   </children>
</AnchorPane>
