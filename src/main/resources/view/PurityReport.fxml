<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane fitToWidth="true" styleClass="edge-to-edge, page-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PurityReportController">
   <content>
      <VBox alignment="TOP_CENTER" styleClass="page">
         <children>
            <VBox maxWidth="640.0" spacing="16.0">
               <children>
                  <VBox spacing="4.0">
                     <children>
                        <Label styleClass="page-title" text="Report water purity" />
                        <HBox alignment="CENTER_LEFT" styleClass="meta-line">
                           <children>
                              <Label text="Purity report #" />
                              <Label fx:id="number" text="-" />
                              <Label text=" · " />
                              <Label fx:id="username" text="-" />
                              <Label text=" · " />
                              <Label fx:id="date" text="-" />
                              <Label text=" " />
                              <Label fx:id="time" text="-" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <Label fx:id="errorMessage" managed="false" maxWidth="Infinity" styleClass="banner, banner-danger" visible="false" wrapText="true">
                     <graphic><FontIcon iconLiteral="mdoal-error_outline" /></graphic>
                  </Label>
                  <VBox styleClass="card">
                     <children>
                        <VBox spacing="2.0">
                           <children>
                              <Label styleClass="section-title" text="Location" />
                              <Label styleClass="help-text" text="Type the coordinates in decimal degrees, or pick the spot on a map." wrapText="true" />
                           </children>
                        </VBox>
                        <HBox alignment="BOTTOM_LEFT" spacing="16.0">
                           <children>
                              <VBox minWidth="0.0" styleClass="field" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="field-label" text="Latitude" />
                                    <TextField fx:id="latitude" accessibleText="Latitude" promptText="e.g. 33.7756" />
                                 </children>
                              </VBox>
                              <VBox minWidth="0.0" styleClass="field" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="field-label" text="Longitude" />
                                    <TextField fx:id="longitude" accessibleText="Longitude" promptText="e.g. -84.3963" />
                                 </children>
                              </VBox>
                              <Button fx:id="pickOnMap" minWidth="-Infinity" mnemonicParsing="false" onAction="#pickOnMapPressed" text="Pick on map">
                                 <graphic><FontIcon iconLiteral="mdomz-my_location" /></graphic>
                                 <tooltip><Tooltip text="Choose the location on a map" /></tooltip>
                              </Button>
                           </children>
                        </HBox>
                        <VBox spacing="2.0">
                           <children>
                              <Label styleClass="section-title" text="Measurements" />
                              <Label styleClass="help-text" text="The overall condition and the measured levels in parts per million (ppm)." wrapText="true" />
                           </children>
                        </VBox>
                        <HBox alignment="BOTTOM_LEFT" spacing="16.0">
                           <children>
                              <VBox minWidth="0.0" styleClass="field" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="field-label" text="Overall condition" />
                                    <ComboBox fx:id="condition" accessibleText="Overall condition" maxWidth="Infinity" promptText="Select condition" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <HBox alignment="BOTTOM_LEFT" spacing="16.0">
                           <children>
                              <VBox minWidth="0.0" styleClass="field" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="field-label" text="Virus (ppm)" />
                                    <TextField fx:id="virusPpm" accessibleText="Virus parts per million" promptText="e.g. 12.5" />
                                 </children>
                              </VBox>
                              <VBox minWidth="0.0" styleClass="field" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="field-label" text="Contaminant (ppm)" />
                                    <TextField fx:id="contaminantPpm" accessibleText="Contaminant parts per million" promptText="e.g. 3" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <HBox styleClass="card-footer">
                           <children>
                              <Button fx:id="back" cancelButton="true" mnemonicParsing="false" onAction="#backPressed" text="Cancel" />
                              <Button fx:id="submitReport" defaultButton="true" mnemonicParsing="false" onAction="#submitPressed" styleClass="accent" text="Submit report">
                                 <graphic><FontIcon iconLiteral="mdoal-check" /></graphic>
                              </Button>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
