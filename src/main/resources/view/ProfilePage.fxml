<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane fitToWidth="true" styleClass="edge-to-edge, page-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ProfileController">
   <content>
      <VBox alignment="TOP_CENTER" styleClass="page">
         <children>
            <VBox maxWidth="720.0" spacing="16.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="identity">
                     <children>
                        <StackPane styleClass="avatar, large">
                           <children>
                              <Label fx:id="initials" />
                           </children>
                        </StackPane>
                        <VBox spacing="4.0">
                           <children>
                              <Label fx:id="fullName" styleClass="page-title" />
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Label fx:id="roleBadge" styleClass="badge" />
                                    <Label fx:id="handle" styleClass="page-subtitle" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <Label fx:id="message" managed="false" maxWidth="Infinity" styleClass="banner, banner-success" visible="false" wrapText="true">
                     <graphic><FontIcon iconLiteral="mdoal-check_circle_outline" /></graphic>
                  </Label>
                  <VBox styleClass="card">
                     <children>
                        <Label styleClass="section-title" text="Account" />
                        <HBox spacing="16.0">
                           <children>
                              <VBox minWidth="0.0" styleClass="field" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="field-label" text="Account type" />
                                    <TextField fx:id="accountType" accessibleText="Account type (read only)" editable="false" focusTraversable="false" styleClass="read-only-field" />
                                 </children>
                              </VBox>
                              <VBox minWidth="0.0" styleClass="field" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="field-label" text="Username" />
                                    <TextField fx:id="user" accessibleText="Username (read only)" editable="false" focusTraversable="false" styleClass="read-only-field" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <Label styleClass="help-text" text="The account type and username cannot be changed." />
                        <Label styleClass="section-title" text="Personal" />
                        <HBox spacing="16.0">
                           <children>
                              <VBox minWidth="0.0" styleClass="field" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="field-label" text="First name" />
                                    <TextField fx:id="fname" accessibleText="First name" />
                                 </children>
                              </VBox>
                              <VBox minWidth="0.0" styleClass="field" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="field-label" text="Last name" />
                                    <TextField fx:id="lname" accessibleText="Last name" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <Label styleClass="section-title" text="Contact" />
                        <HBox spacing="16.0">
                           <children>
                              <VBox minWidth="0.0" styleClass="field" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="field-label" text="Email" />
                                    <TextField fx:id="email" accessibleText="Email" promptText="name@example.com" />
                                 </children>
                              </VBox>
                              <VBox minWidth="0.0" styleClass="field" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="field-label" text="Phone" />
                                    <TextField fx:id="phone" accessibleText="Phone" promptText="Optional" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <VBox styleClass="field">
                           <children>
                              <Label styleClass="field-label" text="Address" />
                              <TextArea fx:id="address" accessibleText="Address" prefRowCount="3" promptText="Optional" wrapText="true" />
                           </children>
                        </VBox>
                        <HBox styleClass="card-footer">
                           <children>
                              <Button fx:id="backToReg" cancelButton="true" mnemonicParsing="false" onAction="#backToRegPressed" onKeyPressed="#backKeyPressed" text="Cancel" />
                              <Button fx:id="saveButton" defaultButton="true" mnemonicParsing="false" onAction="#savePressed" onKeyPressed="#saveEntered" styleClass="accent" text="Save">
                                 <graphic><FontIcon iconLiteral="mdoal-check" /></graphic>
                              </Button>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
