<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- The map page: the map fills the content area, with floating report actions on it and
     a collapsible list of the reports on the right. -->
<BorderPane fx:id="mapPage" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AppViewController">
   <center>
      <StackPane minHeight="0.0" minWidth="0.0">
         <children>
            <WebView fx:id="webView" minHeight="0.0" minWidth="0.0" />
            <HBox fx:id="mapActions" maxHeight="-Infinity" maxWidth="-Infinity" pickOnBounds="false" styleClass="map-actions" StackPane.alignment="TOP_LEFT">
               <children>
                  <Button fx:id="reportSourceButton" minWidth="-Infinity" mnemonicParsing="false" onAction="#createWaterSourceReportClicked" styleClass="accent" text="Report water source">
                     <graphic><FontIcon iconLiteral="mdoal-add_location_alt" /></graphic>
                  </Button>
                  <Button fx:id="reportPurityButton" minWidth="-Infinity" mnemonicParsing="false" onAction="#createPurityReportClicked" text="Report purity">
                     <graphic><FontIcon iconLiteral="mdomz-science" /></graphic>
                  </Button>
                  <Button fx:id="showPanelButton" accessibleText="Show the report list" minWidth="-Infinity" mnemonicParsing="false" onAction="#togglePanel" text="Reports">
                     <graphic><FontIcon iconLiteral="mdomz-view_list" /></graphic>
                     <tooltip><Tooltip text="Show the report list" /></tooltip>
                  </Button>
               </children>
            </HBox>
         </children>
      </StackPane>
   </center>
   <right>
      <VBox fx:id="reportPanel" styleClass="report-panel">
         <children>
            <HBox styleClass="report-panel-header">
               <children>
                  <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="card-title" text="Reports" />
                        <Label fx:id="reportCount" styleClass="caption" wrapText="true" />
                     </children>
                  </VBox>
                  <Button fx:id="hidePanelButton" accessibleText="Hide the report list" mnemonicParsing="false" onAction="#togglePanel" styleClass="flat, button-icon">
                     <graphic><FontIcon iconLiteral="mdoal-close" /></graphic>
                     <tooltip><Tooltip text="Hide the report list" /></tooltip>
                  </Button>
               </children>
            </HBox>
            <ScrollPane fx:id="reportScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="edge-to-edge" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="reportCards" styleClass="report-list" />
               </content>
            </ScrollPane>
            <VBox fx:id="emptyState" managed="false" styleClass="empty-state" visible="false" VBox.vgrow="ALWAYS">
               <children>
                  <FontIcon iconLiteral="mdoal-inbox" styleClass="empty-icon" />
                  <Label styleClass="empty-title" text="No reports yet" />
                  <Label fx:id="emptyText" styleClass="empty-text" text="Reports you can see will appear here and on the map." wrapText="true" />
                  <Region minHeight="4.0" />
                  <Button fx:id="emptyReportButton" mnemonicParsing="false" onAction="#createWaterSourceReportClicked" styleClass="accent" text="Report a water source">
                     <graphic><FontIcon iconLiteral="mdoal-add_location_alt" /></graphic>
                  </Button>
               </children>
            </VBox>
         </children>
      </VBox>
   </right>
</BorderPane>
