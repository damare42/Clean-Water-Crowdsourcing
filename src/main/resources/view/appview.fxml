<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AppViewController">
   <children>
      <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <VBox spacing="2.0" BorderPane.alignment="CENTER">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="6.0">
                     <children>
                        <Label fx:id="welcome" text="Welcome," />
                        <Hyperlink fx:id="username" onAction="#usernamePressed" text="username" />
                        <Pane HBox.hgrow="ALWAYS" />
                        <Button fx:id="logout" mnemonicParsing="false" onAction="#logoutPressed" text="Logout" />
                     </children>
                  </HBox>
                  <FlowPane fx:id="navigation" hgap="4.0" vgap="2.0">
                     <children>
                        <Hyperlink fx:id="createReport" onAction="#createWaterSourceReportClicked" text="Create Water Source Report" />
                        <Hyperlink fx:id="reportList" onAction="#reportListClicked" text="Report List" />
                        <Hyperlink fx:id="createPurityReport" onAction="#createPurityReportClicked" text="Create Purity Report" />
                        <Hyperlink fx:id="purityList" onAction="#purityListClicked" text="Purity Reports" />
                        <Hyperlink fx:id="purityHistory" onAction="#purityHistoryClicked" text="Purity History" />
                        <Hyperlink fx:id="manageAccounts" onAction="#manageAccountsClicked" text="Accounts" />
                        <Hyperlink fx:id="securityLog" onAction="#securityLogClicked" text="Security Log" />
                     </children>
                  </FlowPane>
               </children>
               <padding>
                  <Insets bottom="4.0" left="10.0" right="10.0" top="6.0" />
               </padding>
            </VBox>
         </top>
         <center>
            <WebView fx:id="webView" BorderPane.alignment="CENTER" />
         </center>
      </BorderPane>
   </children>
</AnchorPane>
