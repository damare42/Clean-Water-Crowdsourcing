<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.WSRViewerController">
   <children>
      <HBox styleClass="page-header">
         <children>
            <VBox minWidth="0.0" spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label styleClass="page-title" text="Water source reports" />
                        <Label fx:id="countBadge" styleClass="badge" visible="false" />
                     </children>
                  </HBox>
                  <Label styleClass="page-subtitle" text="Water sources reported by the community. Double-click a report to see its details." wrapText="true" />
               </children>
            </VBox>
            <HBox styleClass="page-actions">
               <children>
                  <Button minWidth="-Infinity" fx:id="detailsButton" mnemonicParsing="false" onAction="#detailsPressed" text="Details">
                     <graphic><FontIcon iconLiteral="mdoal-info" /></graphic>
                     <tooltip><Tooltip text="Show the selected report" /></tooltip>
                  </Button>
               </children>
            </HBox>
         </children>
      </HBox>
      <Label fx:id="message" managed="false" maxWidth="Infinity" styleClass="banner, banner-danger" visible="false" wrapText="true">
         <graphic><FontIcon iconLiteral="mdoal-error_outline" /></graphic>
      </Label>
      <TableView fx:id="reportTable" onKeyPressed="#tableKeyPressed" VBox.vgrow="ALWAYS">
         <placeholder>
            <Label styleClass="page-subtitle" text="No reports yet" />
         </placeholder>
         <columns>
                  <TableColumn fx:id="numberColumn" minWidth="60" prefWidth="70" text="Number" />
                  <TableColumn fx:id="dateColumn" minWidth="90" prefWidth="100" text="Date" />
                  <TableColumn fx:id="timeColumn" minWidth="60" prefWidth="70" text="Time" />
                  <TableColumn fx:id="reporterColumn" minWidth="90" prefWidth="120" text="Reporter" />
                  <TableColumn fx:id="typeColumn" minWidth="70" prefWidth="90" text="Type" />
                  <TableColumn fx:id="conditionColumn" minWidth="90" prefWidth="100" text="Condition" />
                  <TableColumn fx:id="latitudeColumn" minWidth="80" prefWidth="100" text="Latitude" />
                  <TableColumn fx:id="longitudeColumn" minWidth="90" prefWidth="100" text="Longitude" />
         </columns>
      </TableView>
   </children>
</VBox>
