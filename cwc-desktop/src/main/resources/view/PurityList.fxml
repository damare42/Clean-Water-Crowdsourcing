<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PurityListController">
   <children>
      <HBox styleClass="page-header">
         <children>
            <VBox minWidth="0.0" spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label styleClass="page-title" text="Water purity reports" />
                        <Label fx:id="countBadge" managed="false" minWidth="-Infinity" styleClass="badge, badge-neutral" visible="false" />
                     </children>
                  </HBox>
                  <Label styleClass="page-subtitle" text="Purity measurements by workers and managers. Double-click a report or press Enter to see its details." wrapText="true" />
               </children>
            </VBox>
            <HBox styleClass="page-actions">
               <children>
                  <Button fx:id="detailsButton" minWidth="-Infinity" mnemonicParsing="false" onAction="#detailsPressed" text="Details">
                     <graphic><FontIcon iconLiteral="mdoal-info" /></graphic>
                     <tooltip><Tooltip text="Show the selected report" /></tooltip>
                  </Button>
                  <Button fx:id="newReportButton" managed="false" visible="false" minWidth="-Infinity" mnemonicParsing="false" onAction="#newReportPressed" styleClass="accent" text="New report">
                     <graphic><FontIcon iconLiteral="mdomz-science" /></graphic>
                  </Button>
               </children>
            </HBox>
         </children>
      </HBox>
      <Label fx:id="message" managed="false" maxWidth="Infinity" styleClass="banner, banner-danger" visible="false" wrapText="true">
         <graphic><FontIcon iconLiteral="mdoal-error_outline" /></graphic>
      </Label>
      <TableView fx:id="reportTable" onKeyPressed="#tableKeyPressed" VBox.vgrow="ALWAYS">
         <placeholder>
            <VBox styleClass="empty-state">
               <children>
                  <FontIcon iconLiteral="mdoal-inbox" styleClass="empty-icon" />
                  <Label styleClass="empty-title" text="No purity reports yet" />
                  <Label styleClass="empty-text" text="Purity reports filed by workers and managers will be listed here." wrapText="true" />
               </children>
            </VBox>
         </placeholder>
         <columns>
                  <TableColumn fx:id="numberColumn" minWidth="40" prefWidth="40" styleClass="numeric" text="#" />
                  <TableColumn fx:id="dateColumn" minWidth="88" prefWidth="88" text="Date" />
                  <TableColumn fx:id="timeColumn" minWidth="52" prefWidth="52" text="Time" />
                  <TableColumn fx:id="reporterColumn" minWidth="80" prefWidth="80" text="Reporter" />
                  <TableColumn fx:id="conditionColumn" minWidth="90" prefWidth="90" text="Condition" />
                  <TableColumn fx:id="virusColumn" minWidth="88" prefWidth="88" styleClass="numeric" text="Virus PPM" />
                  <TableColumn fx:id="contaminantColumn" minWidth="104" prefWidth="104" styleClass="numeric" text="Contam. PPM" />
                  <TableColumn fx:id="latitudeColumn" minWidth="76" prefWidth="76" styleClass="numeric" text="Latitude" />
                  <TableColumn fx:id="longitudeColumn" minWidth="86" prefWidth="86" styleClass="numeric" text="Longitude" />
         </columns>
      </TableView>
   </children>
</VBox>
