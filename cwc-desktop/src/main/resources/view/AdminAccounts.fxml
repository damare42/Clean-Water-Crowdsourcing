<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AdminAccountsController">
   <children>
      <HBox styleClass="page-header">
         <children>
            <VBox minWidth="0.0" spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label styleClass="page-title" text="Accounts" />
                        <Label fx:id="countBadge" managed="false" minWidth="-Infinity" styleClass="badge, badge-neutral" visible="false" />
                     </children>
                  </HBox>
                  <Label styleClass="page-subtitle" text="Ban, unban or delete accounts. You cannot ban or delete your own account." wrapText="true" />
               </children>
            </VBox>
            <HBox styleClass="page-actions">
               <children>
                  <Button fx:id="banButton" minWidth="-Infinity" mnemonicParsing="false" onAction="#banPressed" text="Ban">
                     <graphic><FontIcon iconLiteral="mdoal-block" /></graphic>
                     <tooltip><Tooltip text="Stop the selected account from signing in" /></tooltip>
                  </Button>
                  <Button fx:id="unbanButton" minWidth="-Infinity" mnemonicParsing="false" onAction="#unbanPressed" text="Unban">
                     <graphic><FontIcon iconLiteral="mdoal-check_circle_outline" /></graphic>
                     <tooltip><Tooltip text="Let the selected account sign in again" /></tooltip>
                  </Button>
                  <Button fx:id="deleteButton" minWidth="-Infinity" mnemonicParsing="false" onAction="#deletePressed" styleClass="danger, button-outlined" text="Delete">
                     <graphic><FontIcon iconLiteral="mdoal-delete" /></graphic>
                     <tooltip><Tooltip text="Delete the selected account" /></tooltip>
                  </Button>
               </children>
            </HBox>
         </children>
      </HBox>
      <Label fx:id="message" managed="false" maxWidth="Infinity" styleClass="banner, banner-success" visible="false" wrapText="true">
         <graphic><FontIcon iconLiteral="mdoal-check_circle_outline" /></graphic>
      </Label>
      <TableView fx:id="accountTable" VBox.vgrow="ALWAYS">
         <placeholder>
            <VBox styleClass="empty-state">
               <children>
                  <FontIcon iconLiteral="mdoal-inbox" styleClass="empty-icon" />
                  <Label styleClass="empty-title" text="No accounts" />
                  <Label styleClass="empty-text" text="Registered accounts will be listed here." wrapText="true" />
               </children>
            </VBox>
         </placeholder>
         <columns>
                  <TableColumn fx:id="idColumn" minWidth="100" prefWidth="120" text="Username" />
                  <TableColumn fx:id="typeColumn" minWidth="90" prefWidth="96" text="Role" />
                  <TableColumn fx:id="firstNameColumn" minWidth="90" prefWidth="110" text="First name" />
                  <TableColumn fx:id="lastNameColumn" minWidth="90" prefWidth="110" text="Last name" />
                  <TableColumn fx:id="emailColumn" minWidth="140" prefWidth="180" text="Email" />
                  <TableColumn fx:id="statusColumn" minWidth="84" prefWidth="90" text="Status" />
         </columns>
      </TableView>
   </children>
</VBox>
