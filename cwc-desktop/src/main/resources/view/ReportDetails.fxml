<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox minHeight="-Infinity" prefWidth="420.0" styleClass="dialog-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ReportDetailsController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <StackPane styleClass="dialog-icon">
               <children><FontIcon fx:id="kindIcon" iconLiteral="mdomz-opacity" /></children>
            </StackPane>
            <Label fx:id="title" minWidth="0.0" styleClass="card-title" text="Water source report" HBox.hgrow="ALWAYS" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="conditionBadge" managed="false" minWidth="-Infinity" styleClass="badge" visible="false" />
         </children>
      </HBox>
      <GridPane fx:id="fields" styleClass="details-grid">
         <columnConstraints>
            <ColumnConstraints minWidth="120.0" />
            <ColumnConstraints hgrow="ALWAYS" />
         </columnConstraints>
      </GridPane>
      <HBox styleClass="card-footer">
         <children>
            <Button fx:id="showOnMap" mnemonicParsing="false" onAction="#showOnMapPressed" text="Show on map">
               <graphic><FontIcon iconLiteral="mdomz-map" /></graphic>
            </Button>
            <Button fx:id="close" cancelButton="true" defaultButton="true" mnemonicParsing="false" onAction="#closePressed" styleClass="accent" text="Close" />
         </children>
      </HBox>
   </children>
</VBox>
