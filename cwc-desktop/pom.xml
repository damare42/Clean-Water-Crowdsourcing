<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>edu.cwc</groupId>
        <artifactId>clean-water-crowdsourcing-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>cwc-desktop</artifactId>
    <name>Clean Water Crowdsourcing - desktop</name>
    <description>JavaFX desktop client for crowdsourced water source reports.</description>

    <properties>
        <main.class>fxapp.Main</main.class>
        <!-- Database file for javafx:run; empty means the default ~/.cwc/cwc.db. Override with:
             ./mvnw -pl cwc-desktop -am compile javafx:run -Dcwc.db.path=/path/to/file.db (or :memory:) -->
        <cwc.db.path></cwc.db.path>
        <!-- Id of the first administrator, created at start-up while none exists; empty
             means no bootstrap. Use: ... javafx:run -Dcwc.bootstrapAdmin=admin -->
        <cwc.bootstrapAdmin></cwc.bootstrapAdmin>
        <!-- Approximate-location lookup URL for javafx:run. "default" means the built-in
             provider (https://ipapi.co/json/); "off" switches IP lookup off.
             Use: ... javafx:run -Dcwc.geo.url=off  (an empty value also means off) -->
        <cwc.geo.url>default</cwc.geo.url>
    </properties>

    <dependencies>
        <dependency>
            <groupId>edu.cwc</groupId>
            <artifactId>cwc-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>${atlantafx.version}</version>
            <exclusions>
                <!-- Built against JavaFX 20; this project's own JavaFX 21 is used instead. -->
                <exclusion>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-controls</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-javafx</artifactId>
            <version>${ikonli.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-material2-pack</artifactId>
            <version>${ikonli.version}</version>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Repository contract tests and test utilities from cwc-core. -->
            <groupId>edu.cwc</groupId>
            <artifactId>cwc-core</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <mainClass>${main.class}</mainClass>
                    <options>
                        <option>-Dcwc.db.path=${cwc.db.path}</option>
                        <option>-Dcwc.bootstrapAdmin=${cwc.bootstrapAdmin}</option>
                        <option>-Dcwc.geo.url=${cwc.geo.url}</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
